# Auth — set at least one of:
# - HARNESS_API_KEY (PAT / service account) for all APIs
# - HARNESS_BEARER_TOKEN (browser session JWT) for CCM `/ccm/*` only; non-CCM tools still need HARNESS_API_KEY
HARNESS_API_KEY=pat.xxxxx.xxxxx.xxxxx
# HARNESS_BEARER_TOKEN=eyJ...
# Required if API key is not a PAT (pat.<accountId>....) — always set when using bearer-only for CCM
HARNESS_ACCOUNT_ID=your-account-id

# Optional — defaults shown
HARNESS_BASE_URL=https://app.harness.io
HARNESS_DEFAULT_ORG_ID=default
HARNESS_DEFAULT_PROJECT_ID=
HARNESS_API_TIMEOUT_MS=30000
HARNESS_MAX_RETRIES=3
# info: Harness API + MCP HTTP timing on stderr (JSON). debug: also truncates request/response bodies in harness-client.
LOG_LEVEL=info

# HTTP transport only — ignored in stdio mode
PORT=3000

# Optional — harness_ccm_chart PNG limits (defaults shown)
# HARNESS_CCM_CHART_MAX_WIDTH=960
# HARNESS_CCM_CHART_MAX_HEIGHT=540
# HARNESS_CCM_CHART_MAX_POINTS=120

# Toolset filtering — comma-separated list of enabled toolsets
# If unset, all toolsets are enabled
# Available: pipelines,services,environments,infrastructure,connectors,secrets,logs,audit,delegates,repositories,registries,templates,dashboards,idp,pull-requests,feature-flags,gitops,chaos,ccm,sei,scs,sto
HARNESS_TOOLSETS=
