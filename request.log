 memoryIdleCost cpuIdleCost\n        __typename\n      }\n      storageDetails @include(if: $isClusterOnly) {\n        id instanceId instanceName claimName claimNamespace clusterName clusterId storageClass volumeType\n        cloudProvider region storageCost storageActualIdleCost storageUnallocatedCost capacity storageRequest\n        storageUtilizationValue createTime deleteTime\n        __typename\n      }\n      __typename\n    }\n    __typename\n  }\n  perspectiveTotalCount(\n    filters: $filters\n    groupBy: $groupBy\n    isClusterQuery: $isClusterOnly\n    isClusterHourlyData: $isClusterHourlyData\n    useCostCategoryStampedData: $useCostCategoryStampedData\n  )\n}",
  "operationName": "FetchperspectiveGrid",
